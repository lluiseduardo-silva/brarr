# Cargo build output
/target
**/*.rs.bk

# Runtime data
*.log
*.pid

# Local orchestrator SQLite (created on first run; see BRARR_DB_PATH)
brarr.db
brarr.db-shm
brarr.db-wal

# Local config / segredos (tokens de tracker, etc.)
.env
.env.*
!.env.example
config.local.toml

# Credenciais soltas deixadas na raiz durante o desenvolvimento.
# Nunca devem ser commitadas — prefira BRARR_TMDB_TOKEN no ambiente ou
# a chave salva em /settings, que fica no banco (também ignorado).
tmdbapikey.txt
*apikey*.txt
*token*.txt
*.secret

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Coverage / profiling
*.profraw
*.profdata
tarpaulin-report.html
cobertura.xml
config.toml

# Session checkpoints (handoff notes between Claude Code sessions)
CHECKPOINT.md
CHECKPOINT-*.md
tmp_*.py

# Claude Code per-project config (preview server launch, etc.)
.claude/

# Local rule fixtures used to test the profile editor — operator-
# specific drafts, not source. Keep them out of source control.
*-rule.json
*-rules.json

# Ferramentas locais baixadas ad-hoc
/tools/

# Chaves privadas. `claude_pmx` é a chave de acesso à LXC de produção e
# estava na raiz do repo sem estar ignorada — um `git add -A` a teria
# commitado num repositório com remote no GitHub. Padrão amplo de
# propósito: uma chave privada nunca deve entrar aqui.
claude_pmx*
id_rsa*
id_ed25519*
*.pem
*.key
plano-adocao.md
biblioteca-real.md
